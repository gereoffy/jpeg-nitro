+plutovg_font_face_t* plutovg_font_face_cache_get_weight(plutovg_font_face_cache_t* cache, const char* family, int weight, bool italic)
+{
+    plutovg_font_face_entry_t* best = NULL;
+    long best_score = 0;
+    plutovg_mutex_lock(&cache->mutex);
+    for(int i = 0; i < cache->size; ++i) {
+        if(strcmp(cache->entries[i]->family, family) != 0)
+            continue;
+        for(plutovg_font_face_entry_t* entry = cache->entries[i]; entry; entry = entry->next) {
+            int diff = entry->weight - weight;
+            if(diff < 0) diff = -diff;
+            // italic first, then normal width, then the weight; of two equally close weights the one
+            // on the side of the request (a light weight: the lighter)
+            bool side = weight < 400 ? entry->weight < weight : entry->weight > weight;
+            long score = (entry->italic != italic) * 100000L + entry->narrow * 10000L + diff * 2 + !side;
+            if(best == NULL || score < best_score) {
+                best = entry;
+                best_score = score;
+            }
+        }
+        break;
+    }
+    plutovg_font_face_t* face = NULL;
+    if(best) {
+        if(best->filename && best->face == NULL)
+            best->face = plutovg_font_face_load_from_file(best->filename, best->ttcindex);
+        face = best->face;
+    }
+    plutovg_mutex_unlock(&cache->mutex);
+    return face;
+}
+
+bool plutovg_font_face_cache_has_style(plutovg_font_face_cache_t* cache, const char* family, bool italic)
+{
+    bool found = false;
+    plutovg_mutex_lock(&cache->mutex);
+    for(int i = 0; i < cache->size && !found; ++i) {
+        for(plutovg_font_face_entry_t* entry = cache->entries[i]; entry; entry = entry->next) {
+            if(strcmp(entry->family, family) == 0 && entry->italic == italic) {
+                found = true;
+                break;
+            }
+        }
+    }
+    plutovg_mutex_unlock(&cache->mutex);
+    return found;
+}
