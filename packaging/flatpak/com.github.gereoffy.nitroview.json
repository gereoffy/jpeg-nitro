{
  "id": "com.github.gereoffy.nitroview",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.llvm21"
  ],
  "default-branch": "stable",
  "command": "nitroview-gnome",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host:ro",
    "--talk-name=org.gtk.vfs.*",
    "--filesystem=xdg-run/gvfs:ro",
    "--filesystem=xdg-run/gvfsd"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/llvm21/bin"
  },
  "modules": [
    {
      "name": "dav1d",
      "buildsystem": "meson",
      "config-opts": [
        "--default-library=static",
        "-Denable_tools=false",
        "-Denable_tests=false",
        "-Denable_examples=false"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz",
          "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5"
        }
      ]
    },
    {
      "name": "nitroview",
      "buildsystem": "simple",
      "build-commands": [
        "make clean",
        "python3 scripts/gen-drawio-stencils.py",
        "case \"$FLATPAK_ARCH\" in x86_64) cpu='-march=x86-64-v3' ;; aarch64) cpu='-mcpu=generic' ;; *) cpu='' ;; esac; make CPUFLAGS=\"$cpu\" DAV1D_DIR=/app gnome",
        "install -Dm755 nitroview-gnome /app/bin/nitroview-gnome",
        "install -Dm644 packaging/gnome/com.github.gereoffy.nitroview.desktop /app/share/applications/com.github.gereoffy.nitroview.desktop",
        "install -Dm644 packaging/icon.png /app/share/icons/hicolor/512x512/apps/com.github.gereoffy.nitroview.png",
        "install -Dm644 packaging/flatpak/com.github.gereoffy.nitroview.metainfo.xml /app/share/metainfo/com.github.gereoffy.nitroview.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/com.github.gereoffy.nitroview/LICENSE"
      ],
      "sources": [
        {
          "type": "git",
          "path": "../..",
          "branch": "main"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/lunasvg/archive/4c7ed7ad6520bf17c574a3ba6c1d1ce7888a7fc0.tar.gz",
          "sha256": "d085d8dfa1dc8f46b3549e3e7edf793932b32c6f4e5e73c232acb6a2852bf670",
          "dest": "third_party/lunasvg"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/libcdr/archive/8d58915cc36d5d660859986c7f186228eff7e89c.tar.gz",
          "sha256": "f7bf69a4f021c0ebea3741a34c67e78cd0a1bf21199e2cd271688444f647d506",
          "dest": "third_party/libcdr"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/pdfparse3/archive/ba99ecda6fd36bf17dc16d35fcc640d2db7cab9e.tar.gz",
          "sha256": "96d83dc2d70a5fab4c0035a7955486af1ae4cf9fd9127b4820844eeeab84a7e6",
          "dest": "third_party/pdfparse3"
        },
        {
          "type": "archive",
          "url": "https://github.com/freetype/freetype/archive/refs/tags/VER-2-15-0.tar.gz",
          "sha256": "87c7f1f8699b91e89f773f7dcfa505b044e1dae67f62a55d4e29c3afdcac4fb8",
          "dest": "third_party/freetype"
        },
        {
          "type": "archive",
          "url": "https://github.com/google/brotli/archive/refs/tags/v1.2.1.tar.gz",
          "sha256": "98d35d11a78dc453aebb7d10c3748f3f73ff78c8267c0dc697b8631f67bf7e8f",
          "dest": "third_party/brotli"
        },
        {
          "type": "archive",
          "url": "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz",
          "sha256": "eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3",
          "dest": "third_party/zstd"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/jgraph/drawio/f411a11f4f6b8994d869bdbc45f4d4d9e2284f34/src/main/webapp/js/stencils.min.js",
          "sha256": "989d72d18bbf02e61c74937d7f51f048d198bb559c3ede4ae66c08e52544b983",
          "dest": "third_party/drawio"
        },
        {
          "type": "archive",
          "url": "https://dev-www.libreoffice.org/src/librevenge-0.0.6.tar.bz2",
          "sha256": "52a65e904d255dbdd97a8b7bb28d6574e14f999eb01416aff004502406d0904d",
          "dest": "third_party/librevenge"
        },
        {
          "type": "patch",
          "path": "../../patches/librevenge.patch",
          "dest": "third_party/librevenge"
        },
        {
          "type": "archive",
          "url": "https://dev-www.libreoffice.org/src/lcms2-2.19.1.tar.gz",
          "sha256": "bfc54f7bab59fbc921012014a8032e4cba4abd46db47d46b76416a8c0b2815c8",
          "dest": "third_party/lcms2"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/libvisio/archive/7fd688eb9d984a699a08f89a012d919cb626530e.tar.gz",
          "sha256": "4a3a9ba5b7b31a0fb3588bd5987bf7369df2e0d7c1855cd0523d9f2018bf76ba",
          "dest": "third_party/libvisio"
        },
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.8.tar.xz",
          "sha256": "277294cb33119ab71b2bc81f2f445e9bc9435b893ad15bb2cd2b0e859a0ee84a",
          "dest": "third_party/libxml2"
        },
        {
          "type": "patch",
          "path": "../../patches/libxml2.patch",
          "dest": "third_party/libxml2"
        },
        {
          "type": "archive",
          "url": "https://archives.boost.io/release/1.89.0/source/boost_1_89_0.tar.bz2",
          "sha256": "85a33fa22621b4f314f8e85e1a5e2a9363d22e4f4992925d4bb3bc631b5a0c7a",
          "dest": "third_party/boost"
        }
      ]
    }
  ]
}
