{
  "id": "com.github.gereoffy.nitroview",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.llvm21"
  ],
  "default-branch": "stable",
  "command": "nitroview-gnome",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host:ro",
    "--talk-name=org.gtk.vfs.*",
    "--filesystem=xdg-run/gvfs:ro",
    "--filesystem=xdg-run/gvfsd"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/llvm21/bin"
  },
  "modules": [
    {
      "name": "dav1d",
      "buildsystem": "meson",
      "config-opts": [
        "--default-library=static",
        "-Denable_tools=false",
        "-Denable_tests=false",
        "-Denable_examples=false"
      ],
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz",
          "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5"
        }
      ]
    },
    {
      "name": "nitroview",
      "buildsystem": "simple",
      "build-commands": [
        "make clean",
        "case \"$FLATPAK_ARCH\" in x86_64) cpu='-march=x86-64-v3' ;; aarch64) cpu='-mcpu=generic' ;; *) cpu='' ;; esac; make CPUFLAGS=\"$cpu\" DAV1D_DIR=/app gnome",
        "install -Dm755 nitroview-gnome /app/bin/nitroview-gnome",
        "install -Dm644 packaging/gnome/com.github.gereoffy.nitroview.desktop /app/share/applications/com.github.gereoffy.nitroview.desktop",
        "install -Dm644 packaging/icon.png /app/share/icons/hicolor/512x512/apps/com.github.gereoffy.nitroview.png",
        "install -Dm644 packaging/flatpak/com.github.gereoffy.nitroview.metainfo.xml /app/share/metainfo/com.github.gereoffy.nitroview.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/com.github.gereoffy.nitroview/LICENSE"
      ],
      "sources": [
        {
          "type": "git",
          "path": "../..",
          "branch": "main"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/lunasvg/archive/1439165b02eab96dbce7e6deb4d94d65acdd7417.tar.gz",
          "sha256": "e5019de94fda99836e9be062d6a787950a6ae27c9fbd12ddc2f009670de312c5",
          "dest": "third_party/lunasvg"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/libcdr/archive/20e4d64e4df41ab695de68572a543f3e8d40829a.tar.gz",
          "sha256": "d96e41f2680ff701263c4bb250ea90979e1d5542a9ac90e13d8976c8dc10dd17",
          "dest": "third_party/libcdr"
        },
        {
          "type": "archive",
          "url": "https://dev-www.libreoffice.org/src/librevenge-0.0.6.tar.bz2",
          "sha256": "52a65e904d255dbdd97a8b7bb28d6574e14f999eb01416aff004502406d0904d",
          "dest": "third_party/librevenge"
        },
        {
          "type": "patch",
          "path": "../../patches/librevenge.patch",
          "dest": "third_party/librevenge"
        },
        {
          "type": "archive",
          "url": "https://dev-www.libreoffice.org/src/lcms2-2.19.1.tar.gz",
          "sha256": "bfc54f7bab59fbc921012014a8032e4cba4abd46db47d46b76416a8c0b2815c8",
          "dest": "third_party/lcms2"
        },
        {
          "type": "archive",
          "url": "https://github.com/gereoffy/libvisio/archive/8453d8b894e2994b379431a9dac9081bea3a104b.tar.gz",
          "sha256": "3ea67172dfe9476d8aa663782c5b8b9a5ee5c038f4eecb053d6899b97ebde24f",
          "dest": "third_party/libvisio"
        },
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libxml2/2.13/libxml2-2.13.8.tar.xz",
          "sha256": "277294cb33119ab71b2bc81f2f445e9bc9435b893ad15bb2cd2b0e859a0ee84a",
          "dest": "third_party/libxml2"
        },
        {
          "type": "patch",
          "path": "../../patches/libxml2.patch",
          "dest": "third_party/libxml2"
        },
        {
          "type": "archive",
          "url": "https://archives.boost.io/release/1.89.0/source/boost_1_89_0.tar.bz2",
          "sha256": "85a33fa22621b4f314f8e85e1a5e2a9363d22e4f4992925d4bb3bc631b5a0c7a",
          "dest": "third_party/boost"
        }
      ]
    }
  ]
}
