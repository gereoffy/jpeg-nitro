[Desktop Entry]
Type=Application
Name=NitroView
Comment=Fast image viewer
Exec=nitroview-gnome %F
Icon=com.github.gereoffy.nitroview
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/vnd.adobe.photoshop;image/tiff;image/gif;image/bmp;image/webp;image/heic;image/heif;image/avif;image/svg+xml;image/vnd.dxf;image/wmf;image/emf;image/x-wmf;image/x-emf;image/x-adobe-dng;application/vnd.visio;application/vnd.ms-visio.drawing.main+xml;application/vnd.ms-visio.drawing.macroEnabled.main+xml;application/vnd.ms-visio.stencil.main+xml;application/vnd.ms-visio.template.main+xml;
StartupNotify=true
