<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>                 <string>nitroview</string>
    <key>CFBundleDisplayName</key>          <string>nitroview</string>
    <key>CFBundleIdentifier</key>           <string>com.github.gereoffy.nitroview</string>
    <key>CFBundleExecutable</key>           <string>nitroview</string>
    <key>CFBundleIconFile</key>             <string>nitroview.icns</string>
    <key>CFBundlePackageType</key>          <string>APPL</string>
    <key>CFBundleShortVersionString</key>   <string>1.0</string>
    <key>CFBundleVersion</key>              <string>1</string>
    <key>LSMinimumSystemVersion</key>       <string>12.0</string>
    <key>NSHighResolutionCapable</key>      <true/>
    <key>NSPrincipalClass</key>             <string>NSApplication</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>     <string>Image</string>
            <key>CFBundleTypeRole</key>     <string>Viewer</string>
            <!-- Alternate: offered in "Open With", never takes over a file type by itself -->
            <key>LSHandlerRank</key>        <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.jpeg</string>
                <string>public.png</string>
                <string>com.adobe.photoshop-image</string>
                <string>public.heic</string>
                <string>public.heif</string>
                <string>public.avif</string>
                <string>public.tiff</string>
                <string>org.webmproject.webp</string>
                <string>com.compuserve.gif</string>
                <string>com.microsoft.bmp</string>
                <string>com.canon.cr2-raw-image</string>
                <string>com.nikon.raw-image</string>
                <string>com.nikon.nrw-raw-image</string>
                <string>com.sony.arw-raw-image</string>
                <string>com.fuji.raw-image</string>
                <string>com.adobe.raw-image</string>
                <string>public.svg-image</string>
                <string>com.autodesk.dxf</string>
                <string>com.autodesk.dwg</string>
                <string>com.microsoft.windows-metafile</string>
                <string>com.microsoft.enhanced-metafile</string>
                <string>com.corel.cdr</string>
                <string>com.corel.cmx</string>
                <string>com.microsoft.visio.drawing</string>
                <string>com.microsoft.visio.drawing-xml</string>
            </array>
        </dict>
        <dict>
            <!-- folders: dropped on the Dock icon, the viewer pages through their images -->
            <key>CFBundleTypeName</key>     <string>Folder</string>
            <key>CFBundleTypeRole</key>     <string>Viewer</string>
            <key>LSHandlerRank</key>        <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.folder</string>
            </array>
        </dict>
    </array>
    <!-- CorelDRAW, DXF, DWG, WMF / EMF and Visio files have no system type: declared here (imported, so a CorelDRAW / AutoCAD / Office / Visio install wins) -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.autodesk.dxf</string>
            <key>UTTypeDescription</key>    <string>AutoCAD DXF drawing</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>dxf</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.autodesk.dwg</string>
            <key>UTTypeDescription</key>    <string>AutoCAD DWG drawing</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>dwg</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.microsoft.windows-metafile</string>
            <key>UTTypeDescription</key>    <string>Windows metafile</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>wmf</string></array>
                <key>public.mime-type</key> <array><string>image/wmf</string><string>image/x-wmf</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.microsoft.enhanced-metafile</string>
            <key>UTTypeDescription</key>    <string>Windows enhanced metafile</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>emf</string></array>
                <key>public.mime-type</key> <array><string>image/emf</string><string>image/x-emf</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.corel.cdr</string>
            <key>UTTypeDescription</key>    <string>CorelDRAW drawing</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>cdr</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.corel.cmx</string>
            <key>UTTypeDescription</key>    <string>Corel Presentation Exchange drawing</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>cmx</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.microsoft.visio.drawing</string>
            <key>UTTypeDescription</key>    <string>Visio drawing</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>vsd</string><string>vss</string><string>vst</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>     <string>com.microsoft.visio.drawing-xml</string>
            <key>UTTypeDescription</key>    <string>Visio drawing (XML)</string>
            <key>UTTypeConformsTo</key>     <array><string>public.image</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key> <array><string>vsdx</string><string>vsdm</string><string>vdx</string><string>vssx</string><string>vssm</string><string>vsx</string><string>vstx</string><string>vstm</string><string>vtx</string></array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
